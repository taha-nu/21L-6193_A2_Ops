# Copy to .env and fill in. .env is git-ignored and docker-ignored: never commit it.
ROLL_NO=21L-6193                      # project name becomes <ROLL_NO>_A2_Ops

# --- DagsHub / MLflow (Task 3.2) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<ROLL_NO>_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub username>
MLFLOW_TRACKING_PASSWORD=<dagshub access token>

# --- Compose stack (Task 6.3) ---
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-long-random
SECRET_KEY=change-me-another-long-random
INFERENCE_MODE=local                 # local | remote
WEB_PORT=8000
# TF_PACKAGE=tensorflow==2.21.0      # uncomment on ARM64 hosts

# --- Cloud model API (Tasks 7-8) ---
API_URL=http://<vm-public-ip>:8080   # or https://<service>.run.app
API_KEY=change-me-shared-secret
